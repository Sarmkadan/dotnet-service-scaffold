<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>dotnet-service-scaffold</PackageId>
    <Version>1.0.0</Version>
    <Authors>Vladyslav Zaiets</Authors>
    <Description>A scaffold for ASP.NET Core (.NET 10) microservices that provides a configured host, health checks, Prometheus metrics, validated configuration binding, and background workers that shut down gracefully.</Description>
    <PackageTags>dotnet;service;scaffold;microservices;aspnetcore;health-checks;prometheus;metrics;configuration;infrastructure</PackageTags>
    <IsPackable>true</IsPackable>
    <Copyright>Copyright (c) 2026 Vladyslav Zaiets</Copyright>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>https://github.com/sarmkadan/dotnet-service-scaffold</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sarmkadan/dotnet-service-scaffold</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="examples\**" />
    <Compile Remove="benchmarks\**" />
    <Content Remove="tests\**" />
    <Content Remove="examples\**" />
    <Content Remove="benchmarks\**" />
    <EmbeddedResource Remove="tests\**" />
    <EmbeddedResource Remove="examples\**" />
    <EmbeddedResource Remove="benchmarks\**" />
    <None Remove="tests\**" />
    <None Remove="examples\**" />
    <None Remove="benchmarks\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Note: do not add Microsoft.AspNetCore.OpenApi / Microsoft.OpenApi 2.x here.
         Swashbuckle is built against Microsoft.OpenApi 1.x; forcing 2.x on it causes a
         TypeLoadException in SwaggerGenerator.GetSwagger at startup. Nothing in this
         project uses AddOpenApi/MapOpenApi, so those packages are unnecessary. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Serilog.AspNetCore" Version="5.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host configuration and tooling files are not part of the library package. -->
    <Content Update="appsettings.json;appsettings.example.json;global.json" Pack="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
